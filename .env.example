# Agent Mesh — variables de entorno
# Copia a .env y ajusta. .env NUNCA se versiona.

# ---------------------------------------------------------------------------
# ATENCIÓN: los dos dominios de abajo son INDEPENDIENTES.
# No derives uno del otro, no los mezcles, no asumas que coinciden.
# (CLAUDE.md, regla 6 — este error ya está señalado como riesgo.)
# ---------------------------------------------------------------------------

# Dominio de correo OBLIGATORIO para dar de alta usuarios del panel /admin.
# Cualquier alta con otro dominio se rechaza.
ADMIN_EMAIL_DOMAIN=empresa-interna.com

# Dominio público por el que se expone el servicio vía túnel de Cloudflare.
# SIN RELACIÓN ALGUNA con ADMIN_EMAIL_DOMAIN.
PUBLIC_SERVICE_DOMAIN=mesh.otrodominio.dev

# ---------------------------------------------------------------------------

# Persistencia. Cambiar a postgresql+psycopg://... debe bastar para migrar.
# Este valor es para correr en local (alembic, uvicorn, pytest).
# En contenedor NO se usa: compose.yaml lo sobrescribe con sqlite:////data/mesh.db,
# que es la ruta del volumen nombrado.
DATABASE_URL=sqlite:///./mesh.db

# Admin creado en el primer arranque. La contraseña es aleatoria y se imprime
# UNA SOLA VEZ en el log del contenedor, con must_change_password=true.
BOOTSTRAP_ADMIN_EMAIL=victor@empresa-interna.com

# Segundos que el servidor retiene una conexión de GET /inbox sin novedades.
LONGPOLL_MAX_SECONDS=30

# Sin heartbeat durante este tiempo, la sesión pasa a 'stale' y sus mensajes
# sin ack vuelven a circular.
SESSION_STALE_AFTER_SECONDS=300

LOG_LEVEL=INFO

# Firma la cookie de sesión del panel. SPEC §4.1 no la lista, pero hace falta.
# Vacía = se genera una al azar en cada arranque, lo que cierra la sesión de los
# administradores cada vez que el contenedor reinicia.
#   Generar:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
